---
import ImagePlaceholder from "./ImagePlaceholder.astro";
import { galleryShots as shots } from "../data/gallery";

// Customer cars from public/generated-cars/. Sources have mixed aspect ratios —
// every cell crops to the same 4:3 frame (object-fit: cover) so the grid stays
// perfectly symmetric. The same list feeds the Marquee ticker.
---

<section class="gallery" id="galleri">
  <div class="container">
    <header class="gallery-head" data-animate="fade-up">
      <span class="section-label">Riktiga resultat</span>
      <div class="gallery-head-row">
        <h2 class="section-heading">
          Resultat som <span class="accent">talar för sig själva</span>
        </h2>
        <p class="gallery-sub">
          Riktiga kundbilar från utförda behandlingar i vår anläggning.
        </p>
      </div>
    </header>

    <div class="gallery-grid" data-animate="stagger">
      {
        shots.map((shot, i) => (
          <div class="gallery-cell">
            <ImagePlaceholder
              src={shot.src}
              alt={shot.alt}
              width={shot.width}
              height={shot.height}
              label={`Kundbild ${i + 1}`}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery {
    padding-block: 5em; /* 80px */
    background-color: var(--color-bg-dark);
  }

  .gallery-head {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5em;
  }

  .gallery-head .section-label {
    align-self: flex-start;
  }

  .gallery-head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3em;
  }

  .section-heading {
    max-width: 36.75em; /* 588px */
  }

  .gallery-sub {
    max-width: 26.1875em; /* 419px */
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-text-body);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1em; /* 16px */
    margin-top: 3.75em; /* 60px */
  }

  /* Identical fixed frame for every cell — sources with different aspect
     ratios are center-cropped, keeping all rows perfectly level */
  .gallery-cell {
    position: relative;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border);
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .gallery-cell:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-0.25em);
  }

  /* Absolutely fill the cell so a source's intrinsic height (e.g. the square
     Kia shot) can never stretch its grid row — the 4:3 cell alone sets size */
  .gallery-cell :global(.img-slot) {
    position: absolute;
    inset: 0;
    height: 100%;
    aspect-ratio: auto !important;
  }

  .gallery-cell :global(.img-placeholder) {
    border: none;
    border-radius: 0;
  }

  @media screen and (max-width: 991px) {
    .gallery-head-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1em;
    }

    .section-heading,
    .gallery-sub {
      max-width: none;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 767px) {
    .gallery {
      padding-block: 3.5em;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75em;
    }
  }
</style>
