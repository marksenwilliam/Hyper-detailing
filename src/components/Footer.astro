---
import { site, activeSocials, fullAddress } from "../data/site";

// Mirrors the actual offer: the three service categories in #tjanster and the
// two packages that only exist in the price list.
const serviceLinks = [
  { label: "Utvändig rekond", href: "/#tjanster" },
  { label: "Invändig rekond", href: "/#tjanster" },
  { label: "Keramiskt vaxskydd", href: "/#tjanster" },
  { label: "Keramiskt lackskydd", href: "/#priser" },
  { label: "Lackering", href: "/#priser" },
];

const quickLinks = [
  { label: "Hem", href: "/#top" },
  { label: "Galleri", href: "/#galleri" },
  { label: "Priser", href: "/#priser" },
  { label: "Vanliga frågor", href: "/#faq" },
  { label: "Kontakt", href: "/#kontakt" },
];

// Pages required or strongly recommended by Swedish consumer and data law —
// see the pages themselves for the statutes each one answers to.
const legalLinks = [
  { label: "Integritetspolicy", href: "/integritetspolicy" },
  { label: "Villkor", href: "/villkor" },
];

const year = new Date().getFullYear();

// Opens the visitor's mail app with the subject already filled in. The
// site-wide contact-link script in BaseLayout falls back to Gmail's compose
// window when no mail app answers the mailto:.
const mailSubject = "Förfrågan via hyperdetailing.se";
const mailtoHref = `mailto:${site.email}?subject=${encodeURIComponent(mailSubject)}`;

// E-handelslagen (2002:562) 8 §: name, address, e-mail, org.nr and VAT number
// must be easy to find. Rows without a value are skipped, but they are
// launch-blocking — see the TODO in src/data/site.ts.
const legalRows = [
  site.orgNumber && `Org.nr ${site.orgNumber}`,
  site.vatNumber && `Momsreg.nr ${site.vatNumber}`,
].filter(Boolean);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <a class="footer-brand" href="/#top" aria-label={`${site.fullName} — startsida`}>
        <img
          src="/assets/brand/logo-horizontal.svg"
          alt=""
          width="659"
          height="96"
        />
      </a>

      <div class="footer-cta">
        <a class="btn btn-primary" href={site.phoneHref}>Ring {site.phone}</a>
        <a class="btn btn-ghost" href={mailtoHref}>Mejla oss</a>
      </div>

      {
        activeSocials.length > 0 ? (
          <ul class="socials" aria-label="Sociala medier">
            {activeSocials.map((social) => (
              <li>
                <a
                  href={social.href}
                  aria-label={`${site.name} på ${social.label}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <img src={social.icon} alt="" width="16" height="16" loading="lazy" />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <span class="footer-top-spacer" aria-hidden="true" />
        )
      }
    </div>

    <div class="footer-grid">
      <div class="footer-col footer-col-contact">
        <h2 class="footer-col-title">Kontakt</h2>
        <ul>
          <li>
            <img src="/assets/icons/icon-pin.svg" alt="" width="20" height="20" />
            <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">{fullAddress}</a>
          </li>
          <li>
            <img src="/assets/icons/icon-phone.svg" alt="" width="20" height="20" />
            <a href={site.phoneHref}>{site.phone}</a>
          </li>
          <li>
            <img src="/assets/icons/icon-mail.svg" alt="" width="20" height="20" />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
        </ul>
      </div>

      <div class="footer-col footer-col-contact">
        <h2 class="footer-col-title">Öppettider</h2>
        <ul>
          {
            site.hours.map((row) => (
              <li>
                <img src="/assets/icons/icon-clock.svg" alt="" width="20" height="20" />
                <span>
                  {row.days}: {row.time}
                </span>
              </li>
            ))
          }
          <li>
            <img src="/assets/icons/icon-check.svg" alt="" width="20" height="20" />
            <span>Endast bokade tider</span>
          </li>
        </ul>
      </div>

      <nav class="footer-col" aria-label="Tjänster">
        <h2 class="footer-col-title">Tjänster</h2>
        <ul>
          {
            serviceLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Genvägar">
        <h2 class="footer-col-title">Genvägar</h2>
        <ul>
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © {year} {site.legalName}
        {legalRows.map((row) => (
          <span class="legal-row">
            <span class="legal-sep" aria-hidden="true">·</span>
            {row}
          </span>
        ))}
      </p>

      <nav class="legal-links" aria-label="Juridisk information">
        {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
  </div>
</footer>

<style>
  /* Surface, radius, and border come from the global .site-footer card rule;
     the root padding insets every row from the card edge. */
  .site-footer {
    padding: var(--cell-padding);
  }

  /* Three stacked rows inside the section card's padding */
  .footer-inner {
    display: flex;
    flex-direction: column;
  }

  /* ---------- Top row ---------- */
  /* Three tracks so the buttons sit dead centre of the row rather than centred
     in the space the brand leaves over. The empty third track is what balances
     the brand block on the left. */
  .footer-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2em;
    padding: 0 0 var(--spacing-2xl);
  }

  .footer-brand {
    display: block;
    width: fit-content;
  }

  .footer-brand img {
    display: block;
    width: auto;
    height: 2.25em; /* 36px — horizontal lockup */
  }

  .footer-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75em;
  }

  /* ---------- Link grid ---------- */
  /* One subtle card per column, separated by real gaps instead of shared seams */
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: stretch;
    gap: 1em;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 1em; /* 16px */
    padding: 1.5em; /* lighter than --cell-padding — a card inside a padded section */
    background-color: var(--color-surface-faint);
    border-radius: var(--radius-card);
  }

  .footer-col-title {
    font-family: var(--font-body);
    font-size: var(--text-base); /* 16px */
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -0.42px;
    color: var(--color-text-white);
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 1em;
  }

  .footer-col a,
  .footer-col span {
    display: block;
    font-size: var(--text-sm); /* 14px */
    line-height: 1.4286;
    letter-spacing: -0.42px;
    color: var(--color-text-white);
  }

  .footer-col a {
    transition: color var(--transition-base);
  }

  .footer-col a:hover {
    color: var(--color-accent);
  }

  .footer-col-contact li {
    display: flex;
    align-items: flex-start;
    gap: 0.625em;
  }

  .footer-col-contact img {
    width: 1.25em;
    height: 1.25em;
    flex-shrink: 0;
    margin-top: 0.05em;
  }

  /* ---------- Bottom row ---------- */
  /* Root padding covers the sides and bottom; keep only the spacing against
     the link grid above. */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75em 1.5em;
    padding: 1.5em 0 0;
  }

  .copyright {
    font-size: var(--text-sm);
    line-height: 1.4286;
    color: var(--color-text-white);
  }

  .legal-sep {
    margin-inline: 0.4em;
    color: var(--color-text-body);
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25em 1.25em;
  }

  .legal-links a {
    font-size: var(--text-sm);
    line-height: 1.4286;
    color: var(--color-text-white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--color-border-strong);
    transition: color var(--transition-base), text-decoration-color var(--transition-base);
  }

  .legal-links a:hover {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  /* Right-hand track of the top row */
  .socials {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1em; /* 16px */
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75em; /* 12px */
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    transition: border-color var(--transition-base), background-color var(--transition-base);
  }

  .socials a:hover {
    border-color: var(--color-accent);
    background-color: rgba(254, 74, 0, 0.1);
  }

  .socials img {
    width: 1em; /* 16px */
    height: 1em;
  }

  /* ---------- Responsive ---------- */
  /* The top row (logo | phone buttons | socials) gives up its three-column
     layout well before the grid below does — a centered vertical stack */
  @media screen and (max-width: 999px) {
    .footer-top {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 1.5em;
    }

    .footer-top-spacer {
      display: none;
    }
  }

  @media screen and (max-width: 991px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* One card per row once two-up gets cramped */
  @media screen and (max-width: 799px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 767px) {
    .socials {
      flex-wrap: wrap;
    }

    /* Match the tighter page rhythm on small screens */
    .footer-grid {
      gap: 0.75em;
    }

    /* Thumb-sized rows. The list gap moves INTO each row, so the column keeps
       its rhythm while every link grows from a ~19px sliver of text to a full
       44px target. px on purpose — see the note on .signup in Navbar.astro. */
    .footer-col ul {
      gap: 0;
    }

    .footer-col li {
      min-height: 44px;
    }

    .footer-col li > a,
    .footer-col li > span {
      display: flex;
      align-items: center;
      min-height: 44px;
    }

    /* The row is taller than the icon now, so the icon centres on it instead
       of hanging from the first line's baseline. */
    .footer-col-contact li {
      align-items: center;
    }

    .footer-col-contact img {
      margin-top: 0;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .legal-row {
      display: block;
    }

    .legal-row .legal-sep {
      display: none;
    }

    .legal-links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  @media screen and (max-width: 479px) {
    .footer-cta {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .footer-cta .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

