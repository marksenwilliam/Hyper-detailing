# Copy to .env for local development. Never commit real values.
#
# GoHighLevel (LeadConnector) sub-account that receives booking requests from
# the form in src/components/Contact.astro via the server route
# src/pages/api/lead.ts. Create the Private Integration Token under
# Settings → Private Integrations in the sub-account; it needs the
# contacts.write scope (and contacts.readonly for the health check).
GHL_PIT=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx
